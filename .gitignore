# Dependencies
node_modules/
.npm

# Build output
dist/

# 올린 이미지 (UPLOAD_DIR 기본값)
/uploads/
*.tsbuildinfo

# Test coverage
coverage/
*.lcov

# Logs
logs
*.log
npm-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Caches
.eslintcache
.cache/
vite.config.*.timestamp-*
vitest.config.*.timestamp-*
.vite/

# dotenv environment variable files (.env.example · .env.test.example 만 올려요)
.env
.env.*
!.env.example
!.env.test.example

# Output of 'npm pack'
*.tgz

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# DB-17: 실제 행사 데이터(계좌번호 등)는 올리지 않아요. seed-data/ 안에서는 example/ 과 README.md 만 올려요.
/seed-data/*
!/seed-data/example/
!/seed-data/README.md
