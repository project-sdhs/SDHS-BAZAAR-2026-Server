# 이 파일을 .env 로 복사해서 사용하세요. (.env 는 git에 올리지 않아요)
# 서버 포트 (기본값 3000)
PORT=3000
# development | test | production (기본값 development)
NODE_ENV=development
# 이미지를 저장하고 /uploads 로 내려줄 폴더 (기본값 uploads)
# 서버에서는 레포 밖 폴더(예: /home/server/projects/sdhs-uploads)를 쓰면 다시 배포해도 사진이 안 지워져요.
UPLOAD_DIR=uploads

# MySQL 접속 정보 (src/db/pool.ts 에서 사용)
# 내 컴퓨터의 MySQL이면 보통 127.0.0.1 / 3306. 팀 서버 DB는 SSH 터널을 연 뒤 그 포트를 적어요.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=bazaar
DB_PASSWORD=
DB_NAME=sdhs_bazaar
